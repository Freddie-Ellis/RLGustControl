# Rust build artifacts — this is the big one, can be hundreds of MB
/target
/*/target/*
Cargo.lock

# Python virtual environments (.venv-hpc is created on the HPC by hpc/setup_python.sh)
.venv/
.venv-hpc/
__pycache__/
*.pyc
*.pyo

# Build artifacts from maturin
/ruststuff/target/*
!/ruststuff/target/wheels/

# Ignore CFD data
/src/data/cfd/
/src/data/cfd_view/

# Ignore Data
/data/*
/runs/*

# OS junk
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Ignore profiles
*.prof
# HPC job logs, and the old in-repo CFD runs folder (runs now go on scratch: RUNS_DIR in src/cfd/case.py)
*.out
/hpc/runs
