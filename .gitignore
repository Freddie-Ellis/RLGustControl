# Rust build artifacts — this is the big one, can be hundreds of MB
/target
/*/target/*
Cargo.lock

# Python virtual environment
.venv/
__pycache__/
*.pyc
*.pyo

# Build artifacts from maturin
/ruststuff/target/*
!/ruststuff/target/wheels/

# Ignore Data
/data/*
/runs/*

# OS junk
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
# HPC job logs and CFD case runs
*.out
/hpc/runs/
